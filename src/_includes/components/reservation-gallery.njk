{#
  Photo gallery for the reservations page.

  Renders nothing at all when reservationPhotos.gallery is empty, so the page
  never shows an empty frame or a "photos coming soon" apology. Add photos in
  src/_data/reservationPhotos.json to switch it on.
#}
{% if reservationPhotos.gallery and reservationPhotos.gallery.length %}
<section class="res-section res-gallery-section" id="gallery" aria-labelledby="gallery-heading">
    <h2 class="res-h2" id="gallery-heading">Take a Look Around</h2>
    <p class="res-lede">
        Every celebration here happens surrounded by books, warm light, and the
        kind of details that make photos worth keeping.
    </p>

    <div class="res-gallery is-collapsed" id="res-gallery" role="list">
        {% for photo in reservationPhotos.gallery %}
        <button
            type="button"
            role="listitem"
            class="res-gallery-item"
            data-gallery-index="{{ loop.index0 }}"
            data-gallery-caption="{{ photo.caption or photo.alt }}"
            aria-label="View larger: {{ photo.alt }}"
        >
            <img
                src="{{ photo.src }}"
                alt="{{ photo.alt }}"
                loading="{% if loop.index0 < 2 %}eager{% else %}lazy{% endif %}"
                decoding="async"
                width="{{ photo.width or 1600 }}"
                height="{{ photo.height or 1067 }}"
            >
            {% if photo.caption %}
            <span class="res-gallery-caption">{{ photo.caption }}</span>
            {% endif %}
        </button>
        {% endfor %}
    </div>

    {#
      With enough photos the gallery gets tall enough to push the packages and
      the inquiry form well below the fold. Collapse it by default and let
      people opt in to the rest. Rendered only when there is something to
      reveal, and unhidden by JS so it never appears as a dead control.
    #}
    {% if reservationPhotos.gallery.length > 6 %}
    <div class="res-gallery-more">
        <button type="button" class="res-gallery-toggle" id="res-gallery-toggle" hidden
                aria-expanded="false" aria-controls="res-gallery" data-ga="gallery_show_all">
            Show all {{ reservationPhotos.gallery.length }} photos
        </button>
    </div>
    {% endif %}
</section>

{# Lightbox shell — populated and controlled by initReservationGallery() in main.js #}
<div class="res-lightbox" id="res-lightbox" hidden>
    <div class="res-lightbox-backdrop" data-lightbox-close></div>
    <div class="res-lightbox-inner" role="dialog" aria-modal="true" aria-label="Photo viewer">
        <button type="button" class="res-lightbox-btn res-lightbox-prev" aria-label="Previous photo">&#8249;</button>
        <figure class="res-lightbox-figure">
            <img src="" alt="" id="res-lightbox-img">
            <figcaption id="res-lightbox-caption"></figcaption>
        </figure>
        <button type="button" class="res-lightbox-btn res-lightbox-next" aria-label="Next photo">&#8250;</button>
        <button type="button" class="res-lightbox-close" aria-label="Close photo viewer" data-lightbox-close>&times;</button>
    </div>
</div>
{% endif %}
