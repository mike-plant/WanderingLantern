<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DD109W64TG"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DD109W64TG');
    </script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {#
      Title resolution:
        1. `seoTitle` in front matter wins outright (use it to target keywords).
        2. Otherwise fall back to `title`, and only append the store name when
           the title doesn't already carry it — several pages set titles like
           "Our Story - The Wandering Lantern", which previously rendered the
           suffix twice.
    #}
    {%- if seoTitle -%}
      {%- set pageTitle = seoTitle -%}
    {%- elif title and (site.name in title) -%}
      {%- set pageTitle = title -%}
    {%- elif title -%}
      {%- set pageTitle = title + " - " + site.name -%}
    {%- else -%}
      {%- set pageTitle = site.name + " - " + site.tagline -%}
    {%- endif -%}
    {#
      Description priority: an explicit `description`, then an event or press
      `excerpt` (so every event page gets its own without touching 25 files),
      then the site default. Duplicate descriptions across a site are treated
      as a quality signal, and before this every page but the homepage shared
      one string.
    #}
    {%- if description -%}
      {%- set pageDescription = description | metaDescription -%}
    {%- elif excerpt and date and ("/events/" in page.url) -%}
      {%- set pageDescription = (date | date("MMMM D, YYYY")) + " · " + (excerpt | metaDescription(125)) -%}
    {%- elif excerpt -%}
      {%- set pageDescription = excerpt | metaDescription -%}
    {%- else -%}
      {%- set pageDescription = site.description -%}
    {%- endif -%}
    {%- set resolvedImage = ogImage or flyerImage or site.defaultImage -%}
    {%- set pageImage = resolvedImage if ("http" in resolvedImage) else (site.url + resolvedImage) -%}
    {%- set canonicalUrl = site.url + page.url -%}

    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}">
    <link rel="canonical" href="{{ canonicalUrl }}">
    {% if noindex %}<meta name="robots" content="noindex, follow">{% else %}<meta name="robots" content="index, follow, max-image-preview:large">{% endif %}

    <!-- Open Graph (Facebook, Instagram link previews, iMessage) -->
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ ogTitle or pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ canonicalUrl }}">
    <meta property="og:image" content="{{ pageImage }}">
    <meta property="og:image:alt" content="{{ ogImageAlt or site.name }}">
    <meta property="og:locale" content="en_US">

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ ogTitle or pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ pageImage }}">

    <!-- Feed discovery. Browsers, readers, and crawlers look for these; they
         are also what /llms.txt points assistants at. -->
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} — Upcoming Events" href="{{ site.url }}/feed.xml">
    <link rel="alternate" type="text/calendar" title="{{ site.name }} — Events Calendar" href="{{ site.url }}/events.ics">
    <link rel="alternate" type="application/json" title="{{ site.name }} — Events (JSON)" href="{{ site.url }}/events.json">

    <!-- Icons. The .ico carries 16/32/48 for legacy and browser-chrome use;
         the small sizes are cropped tighter than the large ones because the
         lantern's line art turns to mush below ~24px. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#5c4d3c">
    <meta name="apple-mobile-web-app-title" content="Wandering Lantern">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Styles -->
    <link rel="stylesheet" href="/assets/css/main.css">

    {# Pages may preload their own LCP image (e.g. the reservations hero). #}
    {% if preloadImage %}<link rel="preload" as="image" href="{{ preloadImage }}" fetchpriority="high">{% endif %}

    {#
      Store-wide identity graph. Two things matter here beyond the obvious:

      1. `@type` is an ARRAY. BookStore is already a subtype of LocalBusiness,
         so "BookStore" alone is semantically correct and Google reads it fine
         — but plenty of third-party SEO auditors and directory scrapers do a
         literal string match for "LocalBusiness" and report it missing.
         Declaring both costs nothing and satisfies both readers.
      2. Opening hours come from site.json, not a literal. They used to be
         hardcoded as 12:00-20:00 here while the header, footer, and press page
         all said 10am-6pm — so the hours Google showed in local results were
         two hours off at both ends, every day.
    #}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": ["BookStore", "LocalBusiness"],
      "@id": "{{ site.url }}/#store",
      "name": "{{ site.name }}",
      "alternateName": "Wandering Lantern Bookstore",
      "slogan": "{{ site.tagline }}",
      "description": "Cleveland's first dedicated children's bookstore, offering curated picture books, middle grade novels, young adult fiction, free weekly storytimes, and a private event space in Lakewood, Ohio.",
      "image": "{{ site.url }}{{ site.defaultImage }}",
      "logo": "{{ site.url }}{{ site.logo }}",
      "url": "{{ site.url }}",
      "telephone": "{{ site.phoneRaw }}",
      "email": "{{ site.email }}",
      "priceRange": "$$",
      "currenciesAccepted": "USD",
      "paymentAccepted": "Cash, Credit Card, Debit Card",
      "hasMap": "{{ site.mapUrl }}",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{ site.street }}",
        "addressLocality": "{{ site.city }}",
        "addressRegion": "{{ site.region }}",
        "postalCode": "{{ site.postalCode }}",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 41.4817,
        "longitude": -81.7982
      },
      "areaServed": [
        { "@type": "City", "name": "Lakewood", "@id": "https://en.wikipedia.org/wiki/Lakewood,_Ohio" },
        { "@type": "City", "name": "Cleveland", "@id": "https://en.wikipedia.org/wiki/Cleveland" },
        { "@type": "City", "name": "Rocky River" },
        { "@type": "City", "name": "Westlake" },
        { "@type": "City", "name": "Bay Village" }
      ],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": {{ site.hours.days | dump | safe }},
          "opens": "{{ site.hours.opens }}",
          "closes": "{{ site.hours.closes }}"
        }
      ],
      "sameAs": [
        "{{ site.instagram }}",
        "{{ site.facebook }}"
      ]
    }
    </script>
</head>
