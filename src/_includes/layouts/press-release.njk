---
layout: layouts/base.njk
---

{#
  A press release is an article, not a generic page. Article markup is what
  lets it surface as a news-style result and gives a crawler an author,
  publisher, and publication date to attribute the claims inside it to.
#}
<script type="application/ld+json">{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  {% if excerpt %}"description": {{ excerpt | dump | safe }},
  {% endif %}"datePublished": "{{ date | date('YYYY-MM-DD') }}",
  "dateModified": "{{ date | date('YYYY-MM-DD') }}",
  "author": {
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}"
  },
  "publisher": { "@id": "{{ site.url }}/#store" },
  "image": ["{{ site.url }}{{ ogImage or site.defaultImage }}"],
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}{{ page.url }}"
  }
}</script>
<script type="application/ld+json">{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
    { "@type": "ListItem", "position": 2, "name": "Press", "item": "{{ site.url }}/press/" },
    { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "{{ site.url }}{{ page.url }}" }
  ]
}</script>

<div class="container">
    <article style="max-width: 800px; margin: 0 auto; padding: 2rem 0;">
        <div style="text-align: center; margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 2px solid var(--parchment);">
            <p style="text-transform: uppercase; letter-spacing: 2px; font-size: 0.85rem; color: var(--warm-brown); margin-bottom: 1rem;">Press Release</p>
            <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 4vw, 2.5rem); color: var(--deep-brown); margin-bottom: 1rem; line-height: 1.3;">{{ title }}</h1>
            <p style="font-size: 1rem; color: var(--warm-brown);">{{ date | date('MMMM D, YYYY') }}</p>
        </div>

        <div style="line-height: 1.9; font-size: 1.05rem;">
            {{ content | safe }}
        </div>

        <div style="margin-top: 4rem; padding-top: 2rem; border-top: 2px solid var(--parchment); text-align: center;">
            <a href="/press/" style="color: var(--aged-gold); text-decoration: none; font-weight: 600; font-size: 1.05rem;">
                ← Back to Press Room
            </a>
        </div>
    </article>
</div>
