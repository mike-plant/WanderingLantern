---
layout: layouts/base.njk
title: Event Space Rental - The Wandering Lantern
seoTitle: "Kids Birthday Party Venue in Lakewood, OH | Wandering Lantern"
description: "Host birthday parties, baby showers, and book clubs inside Cleveland's children's bookstore. Private event space in Lakewood, OH for up to 50 guests."
ogTitle: "Book a Birthday Party at The Wandering Lantern"
ogImageAlt: "The event space at The Wandering Lantern bookstore in Lakewood, Ohio"
---
{%- set heroPhoto = reservationPhotos.hero.src if reservationPhotos.hero else "/storefront-temp.webp" -%}
{%- set heroAlt = reservationPhotos.hero.alt if reservationPhotos.hero else "The Wandering Lantern storefront on Madison Avenue in Lakewood, Ohio" -%}

<div class="reservations-page">

{# ============================================================= HERO #}
{#
  The hero image is a real <img>, not a CSS background: background images are
  invisible to Google Images, and a venue page is exactly the kind of page
  that earns image-search traffic. Keeping it in the DOM also lets it carry
  alt text and act as a properly prioritised LCP element.
#}
<header class="res-hero">
    <img class="res-hero-img" src="{{ heroPhoto }}" alt="{{ heroAlt }}" fetchpriority="high" decoding="async">
    <div class="res-hero-scrim"></div>
    <div class="container res-hero-content">
        <p class="res-hero-eyebrow">Private Event Space &middot; Lakewood, Ohio</p>
        <h1 class="res-hero-title">Throw the Party They&rsquo;ll Still Talk&nbsp;About</h1>
        <p class="res-hero-sub">
            Birthdays, baby showers, and book clubs, held inside a working
            children&rsquo;s bookstore &mdash; surrounded by story, warm light, and
            shelves that make every photo look intentional.
        </p>
        <div class="res-hero-actions">
            <a href="#inquiry-form" class="res-btn res-btn-primary" data-ga="hero_check_availability">
                Check Your Date
            </a>
            {% if reservationPhotos.gallery and reservationPhotos.gallery.length %}
            <a href="#gallery" class="res-btn res-btn-ghost" data-ga="hero_see_space">
                See the Space
            </a>
            {% else %}
            <a href="#packages" class="res-btn res-btn-ghost" data-ga="hero_see_packages">
                See Packages
            </a>
            {% endif %}
        </div>
        <p class="res-hero-note">Usually answered within 24&ndash;48 hours &middot; No deposit to ask</p>
    </div>
</header>

{# ============================================================= TRUST BAR #}
<div class="res-trustbar">
    <div class="container res-trustbar-inner">
        <div class="res-trust-item">
            <span class="res-trust-num">50</span>
            <span class="res-trust-label">guests max<br><small>30 seated</small></span>
        </div>
        <div class="res-trust-item">
            <span class="res-trust-num">100%</span>
            <span class="res-trust-label">private<br><small>after hours</small></span>
        </div>
        <div class="res-trust-item">
            <span class="res-trust-num">3</span>
            <span class="res-trust-label">packages<br><small>space to fully hosted</small></span>
        </div>
        <div class="res-trust-item">
            <span class="res-trust-num">Madison</span>
            <span class="res-trust-label">Ave, Lakewood<br><small>street parking</small></span>
        </div>
    </div>
</div>

<div class="container">

    {# ============================================================= GALLERY #}
    {% include "components/reservation-gallery.njk" %}

    {# ============================================================= PACKAGES #}
    <section class="res-section" id="packages" aria-labelledby="packages-heading">
        <h2 class="res-h2" id="packages-heading">Three Ways to Celebrate</h2>
        <p class="res-lede">
            Book the room and run it yourself, or hand us the whole day. Most
            families land somewhere in the middle &mdash; we&rsquo;ll help you pick.
        </p>

        <div class="res-packages">

            {%- set sg = reservationPricing.packages["secret-garden"] -%}
            <article class="res-package">
                <header class="res-package-head">
                    <h3 class="res-package-name">The Secret Garden</h3>
                    <p class="res-package-tag">Just the space</p>
                </header>
                {% if sg.from %}
                <p class="res-package-price">Starting at <strong>${{ sg.from }}</strong> <span>/ {{ sg.unit }}</span></p>
                {% endif %}
                <p class="res-package-body">
                    The room is yours. Tables and chairs are set how you want them,
                    or leave our cozy furniture where it is. Bring your own food,
                    cake, decorations, and plans &mdash; setup and cleanup are yours.
                </p>
                <ul class="res-package-list">
                    <li>Private use of the event space</li>
                    <li>Tables, chairs, and flexible layout</li>
                    <li>Bring your own food, cake, and decor</li>
                    <li class="res-package-list-bonus">Staff-led story time added free when available</li>
                </ul>
                <a href="#inquiry-form" class="res-package-cta" data-ga="package_secret_garden">Ask about this &rarr;</a>
            </article>

            {%- set mh = reservationPricing.packages["mad-hatters-tea-party"] -%}
            <article class="res-package res-package--featured">
                <span class="res-package-flag">Most booked</span>
                <header class="res-package-head">
                    <h3 class="res-package-name">Mad Hatter&rsquo;s Tea&nbsp;Party</h3>
                    <p class="res-package-tag">Story + activity</p>
                </header>
                {% if mh.from %}
                <p class="res-package-price">Starting at <strong>${{ mh.from }}</strong> <span>/ {{ mh.unit }}</span></p>
                {% endif %}
                <p class="res-package-body">
                    Everything in The Secret Garden, plus a guided story time and a
                    simple creative activity. The structure does the heavy lifting,
                    so nobody has to be the entertainment.
                </p>
                <ul class="res-package-list">
                    <li>Everything in The Secret Garden</li>
                    <li>Guided story time led by our staff</li>
                    <li>Age-appropriate craft, materials included</li>
                    <li>Activity planned with you ahead of time</li>
                </ul>
                <a href="#inquiry-form" class="res-package-cta" data-ga="package_mad_hatter">Ask about this &rarr;</a>
            </article>

            {%- set rb = reservationPricing.packages["royal-ball"] -%}
            <article class="res-package">
                <header class="res-package-head">
                    <h3 class="res-package-name">The Royal Ball</h3>
                    <p class="res-package-tag">Fully hosted</p>
                </header>
                {% if rb.from %}
                <p class="res-package-price">Starting at <strong>${{ rb.from }}</strong> <span>/ {{ rb.unit }}</span></p>
                {% endif %}
                <p class="res-package-body">
                    Show up, enjoy your own party, go home. We handle story time,
                    the craft, light snacks, and every bit of setup and cleanup.
                </p>
                <ul class="res-package-list">
                    <li>Everything in the Tea Party</li>
                    <li>Light snacks provided</li>
                    <li>Full setup and full cleanup</li>
                    <li>Nothing for you to carry in or out</li>
                </ul>
                <a href="#inquiry-form" class="res-package-cta" data-ga="package_royal_ball">Ask about this &rarr;</a>
            </article>
        </div>

        <p class="res-packages-note">
            {% if reservationPricing.packages["secret-garden"].from %}
            Final pricing depends on group size, day, and time of day. Every quote
            is itemized &mdash; there are no hidden fees.
            {% else %}
            Pricing depends on package, group size, day, and time of day. Tell us
            what you&rsquo;re picturing and we&rsquo;ll send an itemized quote &mdash;
            no hidden fees, no obligation.
            {% endif %}
        </p>
    </section>

    {# ============================================================= OCCASIONS #}
    <section class="res-section" aria-labelledby="occasions-heading">
        <h2 class="res-h2" id="occasions-heading">What People Book It For</h2>
        <p class="res-lede">
            Kids&rsquo; celebrations are most of our calendar, but the room works just
            as well for grown-ups who want somewhere quieter than a restaurant.
        </p>

        <div class="res-occasions">
            <div class="res-occasion">
                <h3>Birthday Parties</h3>
                <p>The bookstore does the theming for you. Add a story time, send guests home with a book instead of a goodie bag.</p>
            </div>
            <div class="res-occasion">
                <h3>Baby Showers</h3>
                <p>A book-themed shower in an actual bookstore. Guests can pick a title for the nursery while they&rsquo;re here.</p>
            </div>
            <div class="res-occasion">
                <h3>Book Clubs</h3>
                <p>A private room, no two-hour table limit, and the book you&rsquo;re discussing on the shelf behind you.</p>
            </div>
            <div class="res-occasion">
                <h3>Family Gatherings</h3>
                <p>Reunions, milestone celebrations, and the kind of get-together where the kids need somewhere to go.</p>
            </div>
            <div class="res-occasion">
                <h3>Tea Parties</h3>
                <p>Dress-up encouraged. Pairs naturally with our Mad Hatter&rsquo;s package and the storybook setting.</p>
            </div>
            <div class="res-occasion">
                <h3>Meetings &amp; Small Events</h3>
                <p>Board meetings, workshops, author talks, and team offsites that want more character than a conference room.</p>
            </div>
        </div>
    </section>

    {# ============================================================= THE SPACE #}
    <section class="res-section" id="the-space" aria-labelledby="space-heading">
        <h2 class="res-h2" id="space-heading">The Room Itself</h2>

        <div class="res-space-grid">
            <div class="res-space-card">
                <h3>Capacity</h3>
                <p>Comfortable for about <strong>30 seated guests</strong>, or up to <strong>50</strong> with a mix of seating and standing. Final capacity depends on your layout and activities.</p>
            </div>
            <div class="res-space-card">
                <h3>Privacy</h3>
                <p>Fully private outside store hours. During store hours we can curtain the space off for a semi-private event, or you can book a full store buyout.</p>
            </div>
            <div class="res-space-card">
                <h3>Duration</h3>
                <p>Booked in <strong>2-hour blocks</strong>, extendable for larger groups or events that need more room to breathe.</p>
            </div>
            <div class="res-space-card">
                <h3>Getting Here</h3>
                <p>{{ site.street }}, {{ site.city }}, {{ site.region }} {{ site.postalCode }} &mdash; on Madison Ave with street parking.
                <a href="https://maps.google.com/?q={{ site.street | urlencode }},+{{ site.city }},+{{ site.region }}+{{ site.postalCode }}" target="_blank" rel="noopener" data-ga="map_click">Open in Maps &rarr;</a></p>
            </div>
        </div>
    </section>

    {# ============================================================= TESTIMONIALS #}
    {% if reservationTestimonials.testimonials and reservationTestimonials.testimonials.length %}
    <section class="res-section" aria-labelledby="testimonials-heading">
        <h2 class="res-h2" id="testimonials-heading">From Families Who&rsquo;ve Celebrated Here</h2>
        <div class="res-testimonials">
            {% for t in reservationTestimonials.testimonials %}
            <blockquote class="res-testimonial">
                <p>&ldquo;{{ t.quote }}&rdquo;</p>
                <cite>{{ t.name }}{% if t.detail %}<span>{{ t.detail }}</span>{% endif %}</cite>
            </blockquote>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {# ============================================================= HOW IT WORKS #}
    <section class="res-section" aria-labelledby="how-heading">
        <h2 class="res-h2" id="how-heading">How Booking Works</h2>
        <ol class="res-steps">
            <li class="res-step">
                <span class="res-step-num">1</span>
                <h3>Send your date</h3>
                <p>Fill out the form below. Only your name and email are required &mdash; everything else helps us quote faster, but skip what you don&rsquo;t know yet.</p>
            </li>
            <li class="res-step">
                <span class="res-step-num">2</span>
                <h3>We reply with options</h3>
                <p>Within 24&ndash;48 hours you&rsquo;ll get availability, an itemized price, and a recommendation on which package actually fits what you described.</p>
            </li>
            <li class="res-step">
                <span class="res-step-num">3</span>
                <h3>Lock it in</h3>
                <p>We confirm the details in a short event agreement. Come see the space in person any time before then &mdash; no appointment needed during store hours.</p>
            </li>
        </ol>
    </section>

    {# ============================================================= INQUIRY FORM #}
    <section id="inquiry-form" class="res-section res-form-section" aria-labelledby="form-heading">
        <h2 class="res-h2" id="form-heading">Check Your Date</h2>
        <p class="res-lede">
            Tell us what you&rsquo;re picturing. We&rsquo;ll come back with availability,
            pricing, and which package fits &mdash; usually within 24&ndash;48 hours.
        </p>

        <p class="res-form-reassure">
            Not sure which package you want? Leave it blank. Most people do, and
            we&rsquo;ll help you decide.
        </p>

        <form
            action="https://formspree.io/f/xnjdroye"
            method="POST"
            class="res-form"
            id="reservation-form"
        >
            <input type="hidden" name="_subject" id="rental-subject" value="Event Space Rental Inquiry - The Wandering Lantern">
            <input type="hidden" name="form_type" value="event_rental_inquiry">

            <div class="res-field">
                <label for="name">Your Name <span class="res-req">*</span></label>
                <input type="text" id="name" name="name" autocomplete="name" required>
            </div>

            <div class="res-field">
                <label for="email">Email Address <span class="res-req">*</span></label>
                <input type="email" id="email" name="email" autocomplete="email" required>
            </div>

            <div class="res-field">
                <label for="phone">Phone Number <span class="res-opt">optional</span></label>
                <input type="tel" id="phone" name="phone" autocomplete="tel">
            </div>

            <div class="res-field">
                <label for="package">Event Package <span class="res-opt">optional</span></label>
                <select id="package" name="package">
                    <option value="">Not sure yet &mdash; help me choose</option>
                    <option value="secret-garden">The Secret Garden (space only)</option>
                    <option value="mad-hatters-tea-party">Mad Hatter&rsquo;s Tea Party (story + activity)</option>
                    <option value="royal-ball">The Royal Ball (fully hosted)</option>
                </select>
            </div>

            <div class="res-field">
                <label for="event-type">Type of Event <span class="res-opt">optional</span></label>
                <select id="event-type" name="event_type">
                    <option value="">Select event type&hellip;</option>
                    <option value="birthday">Birthday Party</option>
                    <option value="baby-shower">Baby Shower</option>
                    <option value="book-club">Book Club</option>
                    <option value="family-gathering">Family Gathering</option>
                    <option value="tea-party">Tea Party</option>
                    <option value="meeting">Meeting or Workshop</option>
                    <option value="other">Something else</option>
                </select>
            </div>

            <div class="res-field-row">
                <div class="res-field">
                    <label for="preferred-date">Preferred Date <span class="res-opt">optional</span></label>
                    <input type="date" id="preferred-date" name="preferred_date">
                </div>
                <div class="res-field">
                    <label for="guest-count">Expected Guests <span class="res-opt">optional</span></label>
                    <input type="number" id="guest-count" name="guest_count" min="1" max="50" inputmode="numeric">
                </div>
            </div>

            <div class="res-field">
                <label for="duration">Rental Duration <span class="res-opt">optional</span></label>
                <select id="duration" name="duration">
                    <option value="">Select duration&hellip;</option>
                    <option value="2-hours">2 hours</option>
                    <option value="4-hours">4 hours</option>
                    <option value="other">Other (tell us below)</option>
                </select>
            </div>

            <div class="res-field">
                <label for="message">Additional Details</label>
                <textarea id="message" name="message" rows="5"
                    placeholder="Ages of the kids, alternative dates, food plans, anything you're picturing..."></textarea>
            </div>

            <button type="submit" class="res-btn res-btn-primary res-btn-block" data-ga="form_submit">
                Send My Inquiry
            </button>

            <p class="res-form-fineprint">
                We&rsquo;ll follow up to confirm availability, walk through options, and
                share pricing. Final details are confirmed in your event agreement.
                No deposit is required to ask.
            </p>
        </form>
    </section>

    {# ============================================================= FAQ #}
    <section class="res-section" id="faq" aria-labelledby="faq-heading">
        <h2 class="res-h2" id="faq-heading">Frequently Asked Questions</h2>

        <div class="res-faq">
            {% for item in reservationFaq.faqs %}
            <details class="res-faq-item"{% if loop.first %} open{% endif %}>
                <summary>{{ item.q }}</summary>
                <div class="res-faq-answer">{{ item.a | safe }}</div>
            </details>
            {% endfor %}
        </div>
    </section>

    {# ============================================================= CONTACT #}
    <section class="res-section res-contact" aria-labelledby="contact-heading">
        <h2 class="res-h2" id="contact-heading">Rather Just Talk to Someone?</h2>
        <p class="res-lede">
            Call or email and we&rsquo;ll walk you through it. You&rsquo;re also welcome to
            stop in during store hours and see the space &mdash; no appointment needed.
        </p>
        <div class="res-contact-methods">
            <a href="tel:{{ site.phoneRaw }}" class="res-contact-method" data-ga="contact_phone">
                <strong>Call</strong>
                <span>{{ site.phone }}</span>
            </a>
            <a href="mailto:{{ site.email }}?subject=Event%20Space%20Question" class="res-contact-method" data-ga="contact_email">
                <strong>Email</strong>
                <span>{{ site.email }}</span>
            </a>
        </div>
    </section>

</div>{# /.container #}

{# ============================================================= STICKY MOBILE CTA #}
<div class="res-sticky-cta" id="res-sticky-cta" aria-hidden="true">
    <span class="res-sticky-text">Private parties &amp; showers</span>
    <a href="#inquiry-form" class="res-btn res-btn-primary" data-ga="sticky_check_date">Check Your Date</a>
</div>

</div>{# /.reservations-page #}

{# =============================================================
   STRUCTURED DATA
   Google reads JSON-LD from the body as well as the head. These blocks make
   the page eligible for FAQ rich results and describe the rental itself as a
   service offered by the store, which the store-wide BookStore schema in
   head.njk does not cover.
   ============================================================= #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "{{ site.url }}/reservations/#service",
  "name": "Private Event Space Rental",
  "serviceType": "Event venue rental",
  "description": "Private event space rental at The Wandering Lantern children's bookstore in Lakewood, Ohio. Birthday parties, baby showers, book clubs, and small private gatherings for up to 50 guests.",
  "url": "{{ site.url }}/reservations/",
  "provider": { "@id": "{{ site.url }}/#store" },
  "areaServed": [
    { "@type": "City", "name": "Lakewood", "containedInPlace": { "@type": "State", "name": "Ohio" } },
    { "@type": "City", "name": "Cleveland", "containedInPlace": { "@type": "State", "name": "Ohio" } }
  ],
  "audience": { "@type": "Audience", "audienceType": "Families, parents, and small groups" },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Event Space Packages",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "The Secret Garden",
        "description": "Private use of the event space with tables and chairs. Bring your own food, decorations, and activities."
        {%- if reservationPricing.packages["secret-garden"].from -%}
        , "price": "{{ reservationPricing.packages["secret-garden"].from }}",
        "priceCurrency": "{{ reservationPricing.currency }}"
        {%- endif -%}
      },
      {
        "@type": "Offer",
        "name": "Mad Hatter's Tea Party",
        "description": "Private space plus a staff-led story time and a guided, age-appropriate craft activity with materials included."
        {%- if reservationPricing.packages["mad-hatters-tea-party"].from -%}
        , "price": "{{ reservationPricing.packages["mad-hatters-tea-party"].from }}",
        "priceCurrency": "{{ reservationPricing.currency }}"
        {%- endif -%}
      },
      {
        "@type": "Offer",
        "name": "The Royal Ball",
        "description": "Fully hosted celebration including story time, craft activity, light snacks, and complete setup and cleanup."
        {%- if reservationPricing.packages["royal-ball"].from -%}
        , "price": "{{ reservationPricing.packages["royal-ball"].from }}",
        "priceCurrency": "{{ reservationPricing.currency }}"
        {%- endif -%}
      }
    ]
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "{{ site.url }}/reservations/#faq",
  "mainEntity": [
    {%- for item in reservationFaq.faqs %}
    {
      "@type": "Question",
      "name": {{ item.q | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ item.a | striptags | dump | safe }}
      }
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
    { "@type": "ListItem", "position": 2, "name": "Book Our Space", "item": "{{ site.url }}/reservations/" }
  ]
}
</script>
