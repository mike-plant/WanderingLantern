{%- comment -%}
  A row of books from one collection. Scrolls sideways on phones, wraps into
  a grid on desktop. Sold-out books are skipped so the row only shows things
  people can buy.
{%- endcomment -%}
{%- assign source = section.settings.collection -%}
{%- if source != blank and source.products_count > 0 -%}
  <div class="lantern-row page-width">
    <div class="lantern-row__head">
      <h2 class="lantern-section-heading">{{ section.settings.heading | default: source.title }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="lantern-row__more" href="{{ source.url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.subheading != blank -%}
      <p class="lantern-row__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <ul class="lantern-row__list" role="list">
      {%- assign shown = 0 -%}
      {%- for product in source.products -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- unless product.available -%}{%- continue -%}{%- endunless -%}
        <li>{% render 'lantern-book-card', product: product %}</li>
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Lantern book row",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See all" },
    { "type": "range", "id": "limit", "label": "Books", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Lantern book row" }]
}
{% endschema %}
